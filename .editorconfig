root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,cff}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{v,sv,tcl,xdc}]
indent_size = 2

[Makefile]
indent_style = tab

# The submission is a frozen record: no editor may reformat it.
[submission/**]
trim_trailing_whitespace = false
insert_final_newline = false
